QTabBar {
    background-color: @base@;
    left: 0;
    border-radius: 0;
}

QTabBar::tab:top,
QTabBar::tab:top:last,
QTabBar::tab:top:only-one {
    color: @textDisabled@;
    background-color: @base@;
    border: none;
    border-top-left-radius: 0.25em;
    border-top-right-radius: 0.25em;
    width: 8em;
    /* The tab's height is one value, and the bar takes its own height from it
       (ProjectTabBar no longer hard-codes 18px). It has to fit the close button
       and its glyph with a little air: at 1.125em with no padding the button was
       taller than the tab it sat in, which is why it looked off-centre and its
       bottom was cut off. */
    min-height: 1.5em;
    max-height: 1.5em;
    min-width: 8ex;
    padding-left: 0.5em;
    padding-right: 0.5em;
    margin: 0;
}

QTabBar::tab:top:selected {
    color: @text@;
    background-color: @raised@;
    border: none;
}

QTabBar::tab:top:!selected {
    border: none;
}

QTabBar::tab:top:next-selected {
    border: none;
}

QTabBar::tab:top:!selected:hover,
QTabBar::tab:top:!selected:first:hover {
    background-color: @hairline@;
    border: none;
}

QTabBar::tab:top:selected:hover {
    background-color: @raisedHover@;
    border: none;
}
