From 25c7ff0e7ad85661b4cd24e259365dc95c1be3b3 Mon Sep 17 00:00:00 2001
From: Gambot <56745325+GbotHQ@users.noreply.github.com>
Date: Fri, 18 Sep 2026 11:09:22 +0200
Subject: [PATCH 9/9] core: blend custom easing by weight instead of scaling
 its domain

calculateBezier() computed

    result = c*(t/d) + b*weight + (c*(t/d) + b)*(1 - weight)

which simplifies to c*(t/d)*(2 - weight) + b, and then used that as the *percent* fed to the
bezier solver. So the weight did not blend the eased curve with the linear one; it scaled the
argument by (2 - weight) - 1.5x at weight 0.5, 2x at weight 0 - pushing the value outside the
[0,1] interval the solver inverts and making the returned transform exceed 1 and run
non-monotonically. A measured example at weight 0.5 with an identity bezier:
0.0000 0.1875 0.3750 0.5625 0.7500 0.9375 0.5343 1.3192 0.9066.

Ease the linear progress and blend by weight, mirroring the non-custom path a few lines below
(result*weight + linear*(1-weight)). At weight 1 this is bit-for-bit the old behaviour, so
existing projects are unaffected unless they use a non-default weight - which is where the old
code was wrong.
---
 src/util/Easing.cpp | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/util/Easing.cpp b/src/util/Easing.cpp
index 8bae396..a8388b8 100644
--- a/src/util/Easing.cpp
+++ b/src/util/Easing.cpp
@@ -213,11 +213,15 @@ double cubicBezierEasedPercent(const double percent, const double x1, const doub
 
 float calculateBezier(const Easing::Param& aParam, const float t, const float b, const float c, const float d) {
     auto [x1, y1, x2, y2] = aParam.cubicBezier;
-    // Initial linear extrapolation
-    const float result = c * (t / d) + b * aParam.weight + (c * (t / d) + b) * (1.0f - aParam.weight);
-    // Modify linear using a custom bezier curve
-    const auto bezier = cubicBezierEasedPercent(result, x1, y1, x2, y2);
-    return static_cast<float>(bezier);
+    const float linear = c * (t / d) + b;
+    // Ease the linear progress, then blend the result against that progress by the weight -
+    // the same shape the non-custom branch below uses. The previous expression folded the
+    // weight into the value handed to the solver, which scales the curve domain by
+    // (2 - weight): 1.5x at weight 0.5 and 2x at weight 0, asking the solver to invert a curve
+    // outside the interval it can invert and returning values above 1 - a non-monotonic
+    // transform - for any key whose weight is not 1. At weight 1 the result is unchanged.
+    const float eased = static_cast<float>(cubicBezierEasedPercent(linear, x1, y1, x2, y2));
+    return eased * aParam.weight + linear * (1.0f - aParam.weight);
 }
 
 float Easing::calculate(const Param& aParam, const float t, const float b, const float c, const float d) {
